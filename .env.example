# 데이터베이스 연결
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/textbook_learning

# JWT 시크릿 (프로덕션에서 반드시 강력한 랜덤 문자열로 교체)
ACCESS_TOKEN_SECRET=your-access-token-secret-change-me
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-me

# 서버 설정
PORT=3000
NODE_ENV=development

# CORS 허용 오리진 (프론트엔드 개발 서버)
CORS_ORIGIN=http://localhost:5173
